APP_NAME=SIU Digital Certificate
APP_ENV=development

DATABASE_URL=postgresql://siu_cert:password@localhost:5432/siu_cert_db

SECRET_KEY=change-me-to-a-very-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=info

# Directory for storing PDFs, QR codes, uploaded files
UPLOAD_DIR=./uploads

# Public base URL used in QR code verify links
PUBLIC_BASE_URL=http://localhost:8000
